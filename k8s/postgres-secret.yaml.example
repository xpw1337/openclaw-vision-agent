# Template only — never commit the real password. Create the actual Secret with:
#   kubectl -n surveillance create secret generic postgres-credentials --from-literal=POSTGRES_PASSWORD=<your-password>
# (scripts/build-and-deploy.ps1 does this for you.)
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: surveillance
type: Opaque
stringData:
  POSTGRES_PASSWORD: "REPLACE_ME"
