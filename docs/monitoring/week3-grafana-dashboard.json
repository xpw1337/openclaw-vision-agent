{
  "title": "OpenClaw Week 3 Reliability",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Sampler Publish Rate",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (camera_id, zone) (rate(vision_sampler_jobs_published_total[5m]))",
          "legendFormat": "{{camera_id}} / {{zone}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Worker Processing Rate",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (result) (rate(vision_jobs_processed_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fusion Ingest Rate",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (zone, has_error) (rate(vision_observations_fused_total[5m]))",
          "legendFormat": "{{zone}} error={{has_error}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Retries And DLQ",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(vision_jobs_retried_total[5m])",
          "legendFormat": "retries"
        },
        {
          "expr": "sum by (terminal) (rate(vision_dlq_messages_total[5m]))",
          "legendFormat": "dlq terminal={{terminal}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Analyze Duration p95",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vision_analyze_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rejected Observations",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (reason) (rate(vision_observations_rejected_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ]
}
