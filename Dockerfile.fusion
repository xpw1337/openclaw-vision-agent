# Fusion service image — NATS consumer + FastAPI read API.
FROM python:3.12-slim

WORKDIR /app

COPY requirements-fusion.txt .
RUN pip install --no-cache-dir -r requirements-fusion.txt

COPY core/ core/
COPY agent/ agent/
COPY fusion/ fusion/

RUN useradd --create-home --uid 1000 fusion
USER fusion

EXPOSE 8000

CMD ["uvicorn", "fusion.api:app", "--host", "0.0.0.0", "--port", "8000"]
