# Template only — never commit the real key. Create the actual Secret with:
#   kubectl -n surveillance create secret generic gemini-api --from-literal=GEMINI_API_KEY=<your-key>
apiVersion: v1
kind: Secret
metadata:
  name: gemini-api
  namespace: surveillance
type: Opaque
stringData:
  GEMINI_API_KEY: "REPLACE_ME"
